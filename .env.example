# Copy this file to .env.local and fill in your values.

# Database — use an absolute path for reliability
# On Linux/Pi: file:/home/youruser/jobtracker/prisma/dev.db
# On macOS:    file:/Users/youruser/jobtracker/prisma/dev.db
# With Docker: DATABASE_URL is set automatically to file:/data/jobtracker.db — leave blank or omit
DATABASE_URL="file:/absolute/path/to/prisma/dev.db"

# Auth — generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# The password used to log in to the app
LOGIN_PASSWORD="your-strong-password-here"

# Optional: customize the app name shown in the UI and page title
# NEXT_PUBLIC_APP_NAME="JobTracker"
